PORT=3001
# Optional. When set, every POST/DELETE needs the header X-API-Key with this value.
API_KEY=
# docu-sentinel-ai
AI_URL=http://localhost:8000
AI_API_KEY=
AI_TIMEOUT_MS=120000
# Where reports and baselines are stored (JSON files). Mount a volume here in production.
DATA_DIR=./data
# Comma-separated list of allowed browser origins (the frontend)
CORS_ORIGINS=http://localhost:3000
# Max request body (reports with up to 100 000 findings are ~20-30 MB)
BODY_LIMIT_MB=100
# Requests per minute per IP
THROTTLE_LIMIT=300
