PORT=3001
# Optional. When set, every POST/DELETE needs the header X-API-Key with this value.
API_KEY=
# docu-sentinel-ai
AI_URL=http://localhost:8000
AI_API_KEY=
AI_TIMEOUT_MS=120000
# Where reports and baselines are stored (JSON files). Mount a volume here in production.
DATA_DIR=./data
# Comma-separated list of allowed browser origins (the frontend)
CORS_ORIGINS=http://localhost:3000
# Max request body (reports with up to 100 000 findings are ~20-30 MB)
BODY_LIMIT_MB=100
# Requests per minute per IP
THROTTLE_LIMIT=300
# Delete saved analyses older than N days (0 = keep forever) and how often to check (ms)
RETENTION_DAYS=0
RETENTION_INTERVAL_MS=3600000
# Storage: PostgreSQL connection string (reports, findings, baselines and users). Empty = JSON files in DATA_DIR.
# Render: use the database's *Internal Database URL*. DATABASE_SSL=true for external URLs of managed databases.
DATABASE_URL=
DATABASE_SSL=false
# User accounts: when JWT_SECRET is set, /analyses and /baselines need "Authorization: Bearer <token>" and each
# report/baseline is private to its owner. Use a long random value (e.g. openssl rand -hex 32).
JWT_SECRET=
JWT_TTL_HOURS=168
ALLOW_REGISTRATION=true
# Optional webhook: POSTed when a saved report has findings at or above WEBHOOK_MIN_RISK (low|medium|high|critical).
# With WEBHOOK_SECRET the body is signed: X-DocuSentinel-Signature: sha256=<hmac hex>
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_MIN_RISK=critical
# Optional: GET /metrics (Prometheus) requires "Authorization: Bearer <METRICS_TOKEN>" when set
METRICS_TOKEN=
